# Demo mode uses the bundled sample catalog and in-memory demo database.
# No Firebase credentials are required.

# Set this to true on Vercel to show the demo sign-in panel in production.
NEXT_PUBLIC_DEMO_MODE=true

# Optional AI chat provider. Keep this server-only; never use a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
